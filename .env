# Portfólio V4 — variáveis do site (Vite). Tudo aqui é PÚBLICO (vai para o navegador):
# nunca coloque chaves de IA, tokens ou senhas neste arquivo.

# Endereço da API do Business OS (o mesmo backend do sistema), terminando em /api
VITE_API_URL="http://localhost:3333/api/api"

# Identificador (slug) da empresa no Business OS cujo site é este.
# Aparece em Business OS → Projetos e ideias → Site público.
VITE_EMPRESA=alex-sousa-tech

# Endereço público deste site (sem barra no fim) — usado no SEO, Open Graph e sitemap
VITE_SITE_URL="https://alex-sousadev.vercel.app"

# Opcional: chave PÚBLICA do Cloudflare Turnstile (só se TURNSTILE_SECRET_KEY estiver no backend)
VITE_TURNSTILE_SITE_KEY=
