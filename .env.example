# Portfólio V4 — variáveis do site (Vite). Tudo aqui é PÚBLICO (vai para o navegador):
# nunca coloque senhas, tokens, chaves de IA ou do banco neste arquivo.
#
# Desenvolvimento: copie para ".env" (já está no .gitignore) e rode a API do Sistema de Gestão em :3333.
# Produção (Vercel): cadastre as mesmas variáveis em Project → Settings → Environment Variables.

# API do Sistema de Gestão Empresarial (o mesmo backend do painel), terminando em /api
#   desenvolvimento: http://localhost:3333/api
#   produção:        https://SEU-BACKEND.onrender.com/api
VITE_API_URL=http://localhost:3333/api

# Identificador do site — igual ao de "Configurações do site" no sistema (padrão: alex-sousa-tech)
VITE_EMPRESA=alex-sousa-tech

# Endereço público deste site, sem barra no fim (SEO, Open Graph e sitemap)
#   desenvolvimento: http://localhost:5173
#   produção:        https://alex-sousadev.vercel.app
VITE_SITE_URL=http://localhost:5173

# Opcional: chave PÚBLICA do Cloudflare Turnstile (só se TURNSTILE_SECRET_KEY estiver no backend)
VITE_TURNSTILE_SITE_KEY=
