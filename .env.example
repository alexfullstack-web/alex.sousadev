# Site oficial Alex Sousa Tech — variáveis de ambiente.
# Copie para ".env" em desenvolvimento (o .env está no .gitignore e NÃO deve ir para o repositório).
# Produção (Vercel): Project → Settings → Environment Variables.

# ---- Públicas (VITE_*: vão para o navegador; nada secreto aqui) ----

# API do Alex Sousa Tech Gestão, terminando em /api/v1. Usada pelo formulário de orçamento.
#   desenvolvimento: http://localhost:3333/api/v1
#   produção:        https://SEU-BACKEND.onrender.com/api/v1
VITE_GESTAO_API_URL=http://localhost:3333/api/v1

# Opcional: chave PÚBLICA do Cloudflare Turnstile (só se TURNSTILE_SECRET_KEY estiver no Gestão)
VITE_TURNSTILE_SITE_KEY=

# ---- Só do servidor (funções da Vercel e build). Nunca use o prefixo VITE_ nelas. ----

# Mesmo endereço da API do Gestão (se vazio, usa VITE_GESTAO_API_URL)
GESTAO_API_URL=

# Chave da integração do site: gere no Gestão em Portfólio → Integração com o site oficial.
# Ela aparece uma única vez. É SECRETA: só aqui e na Vercel.
GESTAO_SITE_KEY=
